# ==== 必須 ====

# PostgreSQL接続文字列（Neon / Supabase 等から取得）
# 例: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# ログインセッションの署名に使うランダムな秘密文字列。第三者に推測されない値にしてください。
# 生成例: openssl rand -base64 32
AUTH_SECRET=

# 社内ログイン用の単一アカウント（メールアドレス）
APP_LOGIN_EMAIL=

# 上記アカウントのパスワードのbcryptハッシュ値（平文パスワードは保存しないこと）
# 生成方法: npm run auth:hash-password -- "設定したいパスワード"
APP_PASSWORD_HASH=

# ==== 任意 ====

# Gemini APIキー（https://aistudio.google.com で無料取得可能）。
# 未設定の場合は相性判定・文面生成がモックモードで動作します。
GEMINI_API_KEY=

# Geminiモデルid（未設定時は無料枠で利用できるFlash系モデルが使われます）
GEMINI_MODEL=gemini-3.6-flash

# 登録後に、つながり申請文を自動生成する最低相性スコア
AUTO_MESSAGE_SCORE_THRESHOLD=80
