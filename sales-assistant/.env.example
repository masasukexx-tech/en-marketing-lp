# ==== 必須 ====

# PostgreSQL接続文字列（Neon / Supabase 等から取得）
# 例: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# ログインセッションの署名に使うランダムな秘密文字列。第三者に推測されない値にしてください。
# 生成例: openssl rand -base64 32
AUTH_SECRET=

# 社内ログイン用の単一アカウント（メールアドレス）
APP_LOGIN_EMAIL=

# 上記アカウントのパスワードのbcryptハッシュ値（平文パスワードは保存しないこと）
# 生成方法: npm run auth:hash-password -- "設定したいパスワード"
APP_PASSWORD_HASH=

# ==== 任意 ====

# Anthropic APIキー。未設定の場合は相性判定・文面生成がモックモードで動作します。
ANTHROPIC_API_KEY=

# Anthropicモデルid（未設定時のデフォルト値のままで通常問題ありません）
ANTHROPIC_MODEL=claude-sonnet-5
